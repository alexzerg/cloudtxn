meta {
  name: Sandbox Health
  type: http
  seq: 1
}

get {
  url: http://127.0.0.1:18000/api/health
  body: none
  auth: none
}

tests {
  test("Kong proxies a healthy isolated sandbox", function() {
    expect(res.status).to.equal(200);
    expect(res.body.production_access).to.equal(false);
    expect(res.body.ai.provider).to.equal("local-ollama");
  });
}
